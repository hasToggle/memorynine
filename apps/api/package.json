{
  "name": "api",
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true npm run build",
    "build": "next build",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "concurrently \"npm:next\" \"npm:stripe\"",
    "next": "next dev -p 3002",
    "start": "next start",
    "stripe": "stripe listen --forward-to localhost:3002/webhooks/payments",
    "test": "bun test",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "dependencies": {
    "@repo/analytics": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/design-system": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/knowledge": "workspace:*",
    "@repo/next-config": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/payments": "workspace:*",
    "@repo/storage": "workspace:*",
    "@sentry/nextjs": "^10.74.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svix": "^2.5.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  }
}
